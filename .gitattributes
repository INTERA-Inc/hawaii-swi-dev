# Normalize text files to LF in the repository and on checkout.
* text=auto eol=lf

# Batch files need CRLF in the working tree to run reliably on Windows.
*.bat text eol=crlf

# MODFLOW binary output; never normalize line endings.
*.hds binary
*.ucn binary
*.cbc binary
*.cbb binary
*.bud binary
*.grb binary
*.bin binary
*.nc binary

# pixi lock file
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
